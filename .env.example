# ==============================================================================
# ADMIT TRADING — Root Environment Configuration Template
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# This file provides environment variables for Docker Compose (both local & production)
# and project-wide configuration.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Mode
# ------------------------------------------------------------------------------
ENVIRONMENT=development
ENABLE_DOCS=false
COMPOSE_PROJECT_NAME=admittrading
PROJECT_NAME="AgriTrade API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_DB=agritrade
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Used by backend service:
# Local development on host connecting to Docker PostgreSQL on port 5433:
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5433/agritrade"
# Docker Compose network: postgresql+psycopg://postgres:postgres@postgres:5432/agritrade

# ------------------------------------------------------------------------------
# 3. Redis Cache
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""
# Docker Compose network: redis://redis:6379/0

# ------------------------------------------------------------------------------
# 4. Security & Sessions
# ------------------------------------------------------------------------------
SESSION_COOKIE_NAME=agritrade_session
ADMIN_SESSION_COOKIE_NAME=agritrade_admin_session
# Generate 64-byte random hex key: python3 -c "import secrets; print(secrets.token_hex(64))"
SESSION_SIGNING_KEY=""
COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# 5. Admin Seed Credentials (CLI / Initial Setup)
# ------------------------------------------------------------------------------
ADMIN_EMAIL="admin@agritrade.gov.kh"
ADMIN_PASSWORD="AdminPassword123!"
ADMIN_NAME="AgriTrade Administrator"

# ------------------------------------------------------------------------------
# 6. Service Ports & Public URLs
# ------------------------------------------------------------------------------
FRONTEND_PORT=80
ADMIN_PORT=5174
BACKEND_PORT=8000

FRONTEND_URL="http://localhost:5173"
ADMIN_URL="http://localhost:5174"
CORS_ORIGINS='["http://localhost:5173", "http://localhost:5174", "http://127.0.0.1:5173", "http://127.0.0.1:5174"]'

# ------------------------------------------------------------------------------
# 7. Resend Transactional Email Service
# ------------------------------------------------------------------------------
# Sign up at https://resend.com and create an API Key at https://resend.com/api-keys
# Format: re_xxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY=""

# Sender email:
# Testing sandbox (before domain verification, can only send to your account email):
#   RESEND_FROM_EMAIL="onboarding@resend.dev"
# Production (after verifying custom domain in Resend):
#   RESEND_FROM_EMAIL="ADMIT TRADING <noreply@yourdomain.com>"
RESEND_FROM_EMAIL="onboarding@resend.dev"

# ------------------------------------------------------------------------------
# 8. Google OAuth 2.0 (Google Cloud Console)
# ------------------------------------------------------------------------------
# Setup in Google Cloud Console -> APIs & Services -> Credentials
# Authorized redirect URI: http://localhost:8000/api/v1/auth/google/callback (local)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"

# ------------------------------------------------------------------------------
# 9. Gemini AI
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 10. KHQR Merchant Payment (ABA PayWay / Bakong)
# ------------------------------------------------------------------------------
KHQR_MERCHANT_NAME=""
KHQR_MERCHANT_ID=""
KHQR_BAKONG_ACCOUNT=""
KHQR_BANK_NAME="ABA Bank"
KHQR_CITY="PHNOM PENH"
KHQR_MCC="6513"
KHQR_PAYWAY_REF=""
KHQR_USD_ACCOUNT=""
KHQR_KHR_ACCOUNT=""
PAYMENT_QR_USD_URL=""
PAYMENT_QR_KHR_URL=""

