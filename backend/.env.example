# Environment template only; no real credentials. Load explicitly:
# uv run --env-file .env uvicorn app.main:app --host 0.0.0.0
ENVIRONMENT=development
PROJECT_NAME="AgriTrade API"
DATABASE_URL=""
# Required HS256 JWT signing key; generate at least 32 random bytes locally.
# Never expose the key or JWTs to browsers. Actual private .env is gitignored.
SESSION_SIGNING_KEY=""
SESSION_COOKIE_NAME=agritrade_session
COOKIE_SECURE=true
# localhost HTTP development ONLY: explicitly set COOKIE_SECURE=false.
ACCESS_TOKEN_MINUTES=15
ADMIN_REFRESH_DAYS=1
MEMBER_REFRESH_DAYS=3
OAUTH_STATE_MINUTES=10
# Grace for already-in-flight requests only; spent credentials cannot refresh.
SESSION_ROTATION_GRACE_SECONDS=5
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""
FRONTEND_URL=""
ADMIN_URL=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""
CORS_ORIGINS='[]'
STORAGE_PATH="./storage/private"
MAX_UPLOAD_BYTES=26214400
# Empty proxy list means never trust arbitrary X-Forwarded-For.
TRUSTED_PROXY_IPS='[]'
# KHQR Merchant Configuration (ABA PayWay)
KHQR_MERCHANT_NAME=""
KHQR_MERCHANT_ID=""
KHQR_BAKONG_ACCOUNT=""
KHQR_BANK_NAME=""
KHQR_CITY=""
KHQR_MCC=""
KHQR_PAYWAY_REF=""
KHQR_USD_ACCOUNT=""
KHQR_KHR_ACCOUNT=""
PAYMENT_QR_USD_URL=""
PAYMENT_QR_KHR_URL=""
# Resend Transactional Email Service (https://resend.com)
# API key starting with re_ from https://resend.com/api-keys
RESEND_API_KEY=""
# Test sender: "onboarding@resend.dev" or custom domain: "ADMIT TRADING <noreply@yourdomain.com>"
RESEND_FROM_EMAIL="onboarding@resend.dev"
# Omit to use the packaged Khmer font, or set a private installed font path.
# RECEIPT_FONT_PATH="/opt/agritrade/fonts/NotoSansKhmer.ttf"
# Native workers: install LibreOffice + Bubblewrap and enable unprivileged user namespaces.
LIBREOFFICE_PATH=""
BWRAP_PATH=""
# Compose wires a network-disabled converter via its private Unix socket instead.
CONVERTER_SOCKET_PATH=""
GEMINI_API_KEY=""
# Redis is an optional analytics cache, not durable job storage.
REDIS_URL=""
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""
REDIS_DASHBOARD_TTL=86400
# Legacy source used only by explicit CLI migration, never authoritative startup.
# DB_PATH="./storage/trade_data.duckdb"
